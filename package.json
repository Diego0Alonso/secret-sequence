{
    "name": "secret-sequence",
    "private": true,
    "packageManager": "pnpm@11.5.0",
    "scripts": {
        "build": "pnpm run build:core && pnpm run build:react",
        "build:core": "pnpm --filter secret-sequence-core build",
        "build:react": "pnpm --filter secret-sequence-react build",
        "test": "pnpm -r test",
        "changeset": "changeset",
        "version": "changeset version",
        "release": "pnpm run build && changeset publish"
    },
    "devDependencies": {
        "@changesets/cli": "^2.29.8"
    }
}
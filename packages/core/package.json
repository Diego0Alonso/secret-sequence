{
  "name": "secret-sequence-core",
  "version": "2.0.2",
  "description": "Headless stratagem-style input engine — detect directional sequences, key combos, and multi-pattern inputs",
  "keywords": [
    "keyboard",
    "stratagem",
    "konami",
    "sequence",
    "shortcut",
    "input-engine",
    "helldivers",
    "headless",
    "key-combo",
    "easter-egg",
    "typescript"
  ],
  "author": "diego0alonso",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Diego0Alonso/secret-sequence.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/Diego0Alonso/secret-sequence/tree/main/packages/core#readme",
  "bugs": "https://github.com/Diego0Alonso/secret-sequence/issues",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "devDependencies": {
    "jsdom": "^28.1.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.0.18"
  }
}